# ============================================================
# Noxrea AI Canvas API — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# All settings have safe defaults for local development.

# ── Database ──────────────────────────────────────────────────
# SQLite connection string (local file).
# For production, consider PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./app.db

# SQLite connection timeout in seconds (default: 30)
DB_TIMEOUT=30

# ── Authentication ────────────────────────────────────────────
# JWT secret key — REQUIRED, change to a random long string in production
JWT_SECRET_KEY=change-me-to-a-random-secret

# Admin account — auto-created on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── URLs ──────────────────────────────────────────────────────
# Public URL for file links (e.g. https://api.yourdomain.com)
# The browser loads images/videos from this URL.
# Single-machine dev: http://localhost:8000
# Two-machine: https://files.yourcompany.com
PUBLIC_URL=http://localhost:8000

# CORS allowed origins (comma-separated list of frontend URLs)
# The browser blocks API calls from other domains unless listed here.
# Set to "*" to allow all origins (discouraged in production).
# Development:
#   http://localhost:3000   (Next.js)
#   http://localhost:5173   (Vite, if used separately)
# Production:
#   https://canvas.yourcompany.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Worker (Background Task Queue) ────────────────────────────
# Worker main loop interval in seconds (default: 2)
# Lower = more responsive but more DB queries
WORKER_POLL_INTERVAL=2

# Max simultaneous AI API calls (default: 10)
# Higher = faster batch processing but more API rate limit risk
WORKER_MAX_CONCURRENCY=10

# AI API call timeout in seconds (default: 120)
# If a provider doesn't respond within this time, the task fails
WORKER_API_TIMEOUT=120

# Minutes before a stuck task is considered a zombie (default: 20)
# Tasks stuck in "processing" for longer than this are auto-failed
WORKER_STUCK_TIMEOUT=20

# Seconds between zombie cleanup checks (default: 60)
WORKER_ZOMBIE_INTERVAL=60

# ── SSRF Protection ───────────────────────────────────────────
# 内网地址白名单（逗号分隔），AI Proxy 转发时放行这些地址，
# 不配置 / 为空时维持"拦截所有私有网段"的默认行为。
# 仅放行精确 IP，不放行整个网段。
# 例: ALLOWED_INTERNAL_HOSTS=192.168.1.50,192.168.1.51
ALLOWED_INTERNAL_HOSTS=

# ── Debug ─────────────────────────────────────────────────────
# Enables SQLAlchemy query logging (default: false)
# Turn on only when debugging database issues
DEBUG=false
