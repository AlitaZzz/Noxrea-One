# ============================================================
# Noxrea AI Canvas API - 环境配置
# ============================================================
# 复制本文件为 .env，按你的环境修改各项取值。
# 所有配置都有适用于本地开发的默认值。
#
# ⚠️ 重要：JWT_SECRET_KEY 与 ADMIN_PASSWORD 的占位值（change-me-*）在生产会拒绝启动。
#    本地调试若想临时用占位值，设 ALLOW_INSECURE_SECRETS=true（生产严禁）。
#
# ⚠️ 生产部署：表结构以 `alembic upgrade head` 为准，不要依赖启动时的 create_all。

# ── 数据库 ────────────────────────────────────────────────────
# SQLite 连接（开发环境，默认值）
# 生产换 MySQL:   mysql+aiomysql://root:密码@localhost:3306/noxrea
# 生产换 PG:      postgresql+asyncpg://user:密码@localhost:5432/noxrea
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# SQLite 连接超时秒数（仅 SQLite 生效，默认 30）
DB_TIMEOUT=30

# ── 鉴权 ──────────────────────────────────────────────────────
# JWT 签名密钥 - 必填，生产环境换成随机长字符串（占位值会拒绝启动）
JWT_SECRET_KEY=change-me-to-a-random-secret

# 管理员账号 - 首次启动自动创建，已有注册系统可不设
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# 是否开放注册（默认 true=开放）。生产环境建议设为 false。
ALLOW_REGISTRATION=true

# 本地调试逃生开关：允许 JWT_SECRET_KEY/ADMIN_PASSWORD 使用占位值（生产严禁）
ALLOW_INSECURE_SECRETS=false

# ── URL ───────────────────────────────────────────────────────
# 文件链接的对外访问地址（如 https://api.yourdomain.com）
# 浏览器通过这个 URL 加载图片/视频。
# 单机开发:    http://localhost:8000
# 双机部署:    https://files.yourcompany.com
PUBLIC_URL=http://localhost:8000

# CORS 允许的来源（逗号分隔的前端 URL 列表）
# 浏览器会拦截未列在此处的跨域 API 调用。
# 设为 "*" 表示允许所有来源（生产环境不建议）。
# 开发环境:
#   http://localhost:3000   (Next.js)
#   http://localhost:5173   (Vite，如单独使用)
# 生产环境:
#   https://canvas.yourcompany.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Worker（后台任务队列）────────────────────────────────────
# Worker 主循环间隔秒数（默认: 2）
# 调小 = 响应更快，但数据库查询更频繁
WORKER_POLL_INTERVAL=2

# 最大并发 AI API 调用数（默认: 10）
# 调大 = 批处理更快，但更容易触发 API 限流
WORKER_MAX_CONCURRENCY=10

# AI API 调用超时秒数（默认: 120）
# 超过此时间 provider 仍未响应，任务判失败
WORKER_API_TIMEOUT=120

# 任务卡住多久视为僵尸（分钟，默认: 20）
# 处于 "processing" 超过此时间的任务会被自动判失败
WORKER_STUCK_TIMEOUT=20

# 僵尸清理检查间隔秒数（默认: 60）
WORKER_ZOMBIE_INTERVAL=60

# ── 异步轮询（APIMart 等异步 provider 共用）──────────────────
# 轮询间隔秒数（默认: 3.0）
# 异步生图提交后，按此间隔反复查询 /v1/tasks/{id} 直到出结果
WORKER_ASYNC_POLL_INTERVAL=3.0

# 最大轮询次数（默认: 60，即 60 * 3s = 3 分钟上限）
# 超过此次数仍未完成，任务判超时失败
WORKER_ASYNC_POLL_MAX_ATTEMPTS=60

# 首次轮询前的初始等待秒数（默认: 0.0=立即开始）
# 异步任务通常需要处理时间，设 5~10 可跳过前几次无意义的 pending 轮询
WORKER_ASYNC_POLL_INITIAL_DELAY=0.0

# ── 上传 ─────────────────────────────────────────────────────
# 单文件上传上限（MB，默认 30）。超过返回 413。
MAX_UPLOAD_SIZE_MB=30

# ── 全局 HTTP 超时（秒）─────────────────────────────────────
# 场景化预设：不同场景用独立的 connect/read/write/pool。
# 各预设值来自场景对应配置，详见 backend/app/config.py。

# ----  1. 下载 / CDN 图片 ----
HTTP_DL_CONNECT=15
HTTP_DL_READ=30
HTTP_DL_WRITE=10
HTTP_DL_POOL=10

# ---- 2. 异步轮询（GET /v1/tasks/{id}）----
# 极短超时：轮询失败快速重试代价低，避免卡协程
HTTP_POLL_CONNECT=5
HTTP_POLL_READ=10
HTTP_POLL_WRITE=10
HTTP_POLL_POOL=5

# ---- 3. 同步普通 API（/models, /chat/completions）----
HTTP_API_CONNECT=10
HTTP_API_READ=120
HTTP_API_WRITE=30
HTTP_API_POOL=10

# ---- 4. 异步创建任务（POST 提交后不等结果）----
HTTP_ASYNC_CONNECT=10
HTTP_ASYNC_READ=30
HTTP_ASYNC_WRITE=30
HTTP_ASYNC_POOL=10

# 推理服务总耗时硬上限（秒，默认 300）。本地推理较慢，与下载总超时区分；
# 同样作为 asyncio.wait_for 的兜底，防止推理服务卡死长期占用 worker 协程。
HTTP_TIMEOUT_INFERENCE=300

# ── SSRF 防护 ─────────────────────────────────────────────────
# 内网地址白名单（逗号分隔），AI Proxy 转发时放行这些地址，
# 不配置 / 为空时维持"拦截所有私有网段"的默认行为。
# 仅放行精确 IP，不放行整个网段。
# 例: ALLOWED_INTERNAL_HOSTS=192.168.1.50,192.168.1.51
ALLOWED_INTERNAL_HOSTS=

# ── 推理服务 ─────────────────────────────────────────────────
# 运行 inference_service/main.py 后默认监听 http://localhost:8100
INFERENCE_SERVICE_URL=http://localhost:8100

# 推理服务的 API Key（需与 inference_service/.env 的 API_KEY 一致）
# 留空 = 不启用认证（仅开发环境）
INFERENCE_SERVICE_API_KEY=change-me-to-a-random-secret

# ── 日志 ─────────────────────────────────────────────────────
# 日志级别：INFO(默认,看业务关键流) / DEBUG(看轮询/SSE/缓存等诊断细节) / WARNING / ERROR
LOG_LEVEL=INFO
