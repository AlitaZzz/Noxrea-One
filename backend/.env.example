# ============================================================
# Noxrea AI Canvas API - 环境配置
# ============================================================
# 复制本文件为 .env，按你的环境修改各项取值。
# 所有配置都有适用于本地开发的默认值。

# ── 数据库 ────────────────────────────────────────────────────
# SQLite 连接（开发环境，默认值）
# 生产换 MySQL:   mysql+aiomysql://root:密码@localhost:3306/noxrea
# 生产换 PG:      postgresql+asyncpg://user:密码@localhost:5432/noxrea
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# SQLite 连接超时秒数（仅 SQLite 生效，默认 30）
DB_TIMEOUT=30

# ── 鉴权 ──────────────────────────────────────────────────────
# JWT 签名密钥 - 必填，生产环境换成随机长字符串
JWT_SECRET_KEY=change-me-to-a-random-secret

# 管理员账号 - 首次启动自动创建，已有注册系统可不设
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── URL ───────────────────────────────────────────────────────
# 文件链接的对外访问地址（如 https://api.yourdomain.com）
# 浏览器通过这个 URL 加载图片/视频。
# 单机开发:    http://localhost:8000
# 双机部署:    https://files.yourcompany.com
PUBLIC_URL=http://localhost:8000

# CORS 允许的来源（逗号分隔的前端 URL 列表）
# 浏览器会拦截未列在此处的跨域 API 调用。
# 设为 "*" 表示允许所有来源（生产环境不建议）。
# 开发环境:
#   http://localhost:3000   (Next.js)
#   http://localhost:5173   (Vite，如单独使用)
# 生产环境:
#   https://canvas.yourcompany.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Worker（后台任务队列）────────────────────────────────────
# Worker 主循环间隔秒数（默认: 2）
# 调小 = 响应更快，但数据库查询更频繁
WORKER_POLL_INTERVAL=2

# 最大并发 AI API 调用数（默认: 10）
# 调大 = 批处理更快，但更容易触发 API 限流
WORKER_MAX_CONCURRENCY=10

# AI API 调用超时秒数（默认: 120）
# 超过此时间 provider 仍未响应，任务判失败
WORKER_API_TIMEOUT=120

# 任务卡住多久视为僵尸（分钟，默认: 20）
# 处于 "processing" 超过此时间的任务会被自动判失败
WORKER_STUCK_TIMEOUT=20

# 僵尸清理检查间隔秒数（默认: 60）
WORKER_ZOMBIE_INTERVAL=60

# ── SSRF 防护 ─────────────────────────────────────────────────
# 内网地址白名单（逗号分隔），AI Proxy 转发时放行这些地址，
# 不配置 / 为空时维持"拦截所有私有网段"的默认行为。
# 仅放行精确 IP，不放行整个网段。
# 例: ALLOWED_INTERNAL_HOSTS=192.168.1.50,192.168.1.51
ALLOWED_INTERNAL_HOSTS=

# ── 推理服务 ─────────────────────────────────────────────────
# 运行 inference_service/main.py 后默认监听 http://localhost:8100
INFERENCE_SERVICE_URL=http://localhost:8100

# 推理服务的 API Key（需与 inference_service/.env 的 API_KEY 一致）
# 留空 = 不启用认证（仅开发环境）
INFERENCE_SERVICE_API_KEY=change-me-to-a-random-secret

# ── 日志 ─────────────────────────────────────────────────────
# 日志级别：INFO(默认,看业务关键流) / DEBUG(看轮询/SSE/缓存等诊断细节) / WARNING / ERROR
LOG_LEVEL=INFO
