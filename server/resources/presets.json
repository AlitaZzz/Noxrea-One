[
  {
    "name": "Exellome",
    "baseUrl": "https://new.exellome.online/v1",
    "protocol": "openai",
    "config": {
      "request": {
        "mapping": { "ref_images": "image", "ratio": "size"},
        "body_patch": {}
      },
      "protocol": {
        "endpoints": {
          "image.edits": "/images/edits"
        }
      }
    }
  },
  {
    "name": "APIMart",
    "baseUrl": "https://api.apimart.ai/v1",
    "protocol": "openai",
    "config": {
      "request": {
        "mapping": { "ref_images": "image_urls", "ratio": "size"},
        "body_patch": { "official_fallback": false }
      },
      "protocol": {
        "endpoints": {
          "image.edits": "/images/generations"    
        }
      }
    }
  },
  {
    "name": "Agnes",
    "baseUrl": "https://api.agnes-ai.cn/v1",
    "protocol": "openai",
    "config": {
      "request": {
        "mapping": { "ref_images": "extra_body.image", "resolution": "size"},
        "body_patch": {}
      },
      "protocol": {
        "endpoints": {
          "image.edits": "/images/generations",
          "poll": "/videos/{task_id}"          
        }
      }
    }
  },
  {
    "name": "FHL",
    "baseUrl": "https://www.fhl.mom/v1",
    "protocol": "openai",
    "config": {
      "request": {
        "mapping": {
          "ref_images": "images[].image_url",
          "ratio": "size"
        },
        "body_patch": {}
      },
      "protocol": {
        "endpoints": {}
      }
    }
  }
]
