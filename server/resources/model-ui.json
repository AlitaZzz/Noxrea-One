{
  "_default": {
    "image": {
      "allowedFields": ["quality", "resolution", "ratio", "n", "refImages"],
      "fields": [
        { "name": "quality", "type": "segmented", "label": "common.quality", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto", "optionI18nPrefix": "generation.quality" },
        { "name": "resolution", "type": "select", "label": "common.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 3, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "9:16" },
        { "name": "n", "type": "segmented", "label": "common.count", "order": 4, "options": [1, 2, 4], "default": 1, "unit": "generation.countUnit" }
      ],
      "mapping": {
        "refImages": { "field": "image_urls", "kind": "array" }
      }
    },
    "video": {
      "allowedFields": ["ratio", "resolution", "seconds", "generateAudio", "n", "refImages", "refAudios", "refVideos", "refMode"],
      "fields": [
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 1, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
        { "name": "resolution", "type": "select", "label": "common.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "seconds", "type": "slider", "label": "generation.duration", "order": 3, "min": 1, "max": 15, "step": 1, "default": 5, "unit": "generation.secondsUnit" },
        { "name": "generateAudio", "type": "switch", "label": "generation.audio", "order": 4, "default": true, "trueLabel": "generation.audioOn", "falseLabel": "generation.audioOff", "trueShort": "generation.audioOnShort", "falseShort": "generation.audioOffShort" }
      ]
    },
    "llm": {
      "allowedFields": ["messages", "stream"],
      "fields": []
    },
    "audio": {
      "allowedFields": ["mode", "input", "voice", "audio_file", "references"],
      "fields": []
    }
  },
  "*gpt-image*": {
    "image": {
      "fields": [
        { "name": "quality", "type": "segmented", "label": "common.quality", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto", "optionI18nPrefix": "generation.quality" },
        { "name": "resolution", "type": "select", "label": "common.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 3, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
        { "name": "n", "type": "segmented", "label": "common.count", "order": 4, "options": [1, 2, 4], "default": 1, "unit": "generation.countUnit" }
      ],
      "mapping": {
        "ratio": {
          "field": "size",
          "kind": "single",
          "transform": {
            "type": "lookup",
            "composite": ["ratio", "resolution"],
            "table": {
              "1:1|1k": "1024x1024",
              "1:1|2k": "2048x2048",
              "1:1|4k": "2880x2880",
              "3:2|1k": "1536x1024",
              "3:2|2k": "2048x1360",
              "3:2|4k": "3520x2336",
              "2:3|1k": "1024x1536",
              "2:3|2k": "1360x2048",
              "2:3|4k": "2336x3520",
              "4:3|1k": "1024x768",
              "4:3|2k": "2048x1536",
              "4:3|4k": "3312x2480",
              "3:4|1k": "768x1024",
              "3:4|2k": "1536x2048",
              "3:4|4k": "2480x3312",
              "5:4|1k": "1280x1024",
              "5:4|2k": "2560x2048",
              "5:4|4k": "3216x2576",
              "4:5|1k": "1024x1280",
              "4:5|2k": "2048x2560",
              "4:5|4k": "2576x3216",
              "16:9|1k": "1536x864",
              "16:9|2k": "2048x1152",
              "16:9|4k": "3840x2160",
              "9:16|1k": "864x1536",
              "9:16|2k": "1152x2048",
              "9:16|4k": "2160x3840",
              "2:1|1k": "2048x1024",
              "2:1|2k": "2688x1344",
              "2:1|4k": "3840x1920",
              "1:2|1k": "1024x2048",
              "1:2|2k": "1344x2688",
              "1:2|4k": "1920x3840",
              "3:1|1k": "1881x836", 
              "3:1|2k": "3072x1024",
              "3:1|4k": "3840x1280",
              "1:3|1k": "887x1774",
              "1:3|2k": "1024x3072",
              "1:3|4k": "1280x3840",
              "21:9|1k": "2016x864",
              "21:9|2k": "2688x1152",
              "21:9|4k": "3840x1648",
              "9:21|1k": "864x2016",
              "9:21|2k": "1152x2688",
              "9:21|4k": "1648x3840"
            }
          }
        }
      },
      "channels": {
        "api.apimart.ai": {
          "_endpoints": { "image.edits": "/images/generations" },
          "refImages": { "field": "image_urls", "kind": "array" },
          "ratio": { "field": "size", "kind": "single" }
        },
        "new.exellome.online": {
          "_endpoints": { "image.edits": "/images/edits" },
          "refImages": { "field": "image", "kind": "array" },
          "ratio": { "field": "size", "kind": "single" }
        },
        "www.fhl.mom": {
          "_endpoints": { "image.edits": "/images/edits" },
          "refImages": { "field": "images", "kind": "array[].image_url" }
        }
      }
    }
  },
  "*nano-banana*": {
    "image": {
      "fields": [
        { "name": "quality", "type": "segmented", "label": "common.quality", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto", "optionI18nPrefix": "generation.quality" },
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 2, "ratio": true, "options": ["1:1", "2:3", "3:2", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"], "default": "16:9" },
        { "name": "n", "type": "segmented", "label": "common.count", "order": 3, "options": [1, 2, 4], "default": 1, "unit": "generation.countUnit" }
      ]
    }
  },
  "*agnes-image*": {
    "image": {
      "fields": [
        { "name": "resolution", "type": "select", "label": "common.clarity", "order": 1, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 2, "ratio": true, "options": ["1:1", "2:3", "3:2", "3:4", "4:3", "9:16", "16:9", "21:9"], "default": "16:9" },
        { "name": "n", "type": "segmented", "label": "common.count", "order": 3, "options": [1, 2, 4], "default": 1, "unit": "generation.countUnit" }
      ],
      "mapping": {
        "refImages": { "field": "extra_body.image", "kind": "array" },
        "resolution": { "field": "size", "kind": "single" },
        "ratio": { "field": "ratio", "kind": "single" }
      },
      "channels": {
        "api.agnes-ai.cn": {
          "_endpoints": { "image.edits": "/images/generations" }
        }
      }
    }
  },
  "*seedance*": {
    "video": {
      "capabilities": {
        "refMode": { "options": ["first", "first-last", "full"] },
        "generateAudio": { "default": false }
      },
      "fields": [
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 1, "ratio": true, "options": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "adaptive"], "default": "16:9" },
        { "name": "resolution", "type": "select", "label": "common.clarity", "order": 2, "options": ["480p", "720p", "1080p"], "default": "720p" },
        { "name": "seconds", "type": "slider", "label": "generation.duration", "order": 3, "min": 4, "max": 30, "step": 1, "default": 5, "unit": "generation.secondsUnit" },
        { "name": "generateAudio", "type": "switch", "label": "generation.audio", "order": 4, "default": false, "trueLabel": "generation.audioOn", "falseLabel": "generation.audioOff", "trueShort": "generation.audioOnShort", "falseShort": "generation.audioOffShort" }
      ],
      "mapping": {
        "refImages": {
          "field": "image_urls",
          "kind": "array",
          "byRefMode": {
            "first-last": { "field": "image_with_roles", "kind": "role:first-last" }
          }
        },
        "ratio": { "field": "size", "kind": "single" },
        "resolution": { "field": "resolution", "kind": "single" },
        "seconds": { "field": "duration", "kind": "single" },
        "generateAudio": { "field": "generate_audio", "kind": "single" },
        "refVideos": { "field": "video_urls", "kind": "array" },
        "refAudios": { "field": "audio_urls", "kind": "array" }
      },
      "channels": {
        "api.apimart.ai": {
          "refImages": { "field": "image_urls", "kind": "array" },
          "ratio": { "field": "size", "kind": "single" }
        }
      }
    }
  },
  "*agnes-video*": {
    "video": {
      "fields": [
        { "name": "ratio", "type": "select", "label": "common.ratio", "order": 1, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
        { "name": "resolution", "type": "select", "label": "common.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "numFrames", "type": "number", "label": "generation.numFrames", "order": 3, "min": 1, "max": 441, "step": 8, "default": 121, "unit": "generation.framesUnit" },
        { "name": "frameRate", "type": "select", "label": "generation.frameRate", "order": 4, "options": [24, 30], "default": 24 }
      ],
      "mapping": {
        "numFrames": { "field": "num_frames", "kind": "single" },
        "frameRate": { "field": "frame_rate", "kind": "single" },
        "mode": { "field": "extra_body.mode", "kind": "single" }
      },
      "channels": {
        "api.agnes-ai.cn": {
          "_endpoints": {
            "image.edits": "/images/generations",
            "video.poll": "https://api.agnes-ai.cn/agnesapi?video_id={video_id}"
          }
        }
      }
    }
  }
}
