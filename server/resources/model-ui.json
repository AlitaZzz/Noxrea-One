                "2:3|4k": "2336x3520",
                "4:3|1k": "1024x768",
                "4:3|2k": "2048x1536",
                "4:3|4k": "3312x2480",
                "3:4|1k": "768x1024",
                "3:4|2k": "1536x2048",
                "3:4|4k": "2480x3312",
                "5:4|1k": "1280x1024",
                "5:4|2k": "2560x2048",
                "5:4|4k": "3216x2576",
                "4:5|1k": "1024x1280",
                "4:5|2k": "2048x2560",
                "4:5|4k": "2576x3216",
                "16:9|1k": "1536x864",
                "16:9|2k": "2048x1152",
                "16:9|4k": "3840x2160",
                "9:16|1k": "864x1536",
                "9:16|2k": "1152x2048",
                "9:16|4k": "2160x3840",
                "2:1|1k": "2048x1024",
                "2:1|2k": "2688x1344",
                "2:1|4k": "3840x1920",
                "1:2|1k": "1024x2048",
                "1:2|2k": "1344x2688",
                "1:2|4k": "1920x3840",
                "3:1|1k": "1881x836",
                "3:1|2k": "3072x1024",
                "3:1|4k": "3840x1280",
                "1:3|1k": "887x1774",
