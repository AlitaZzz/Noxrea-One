{
  "_comment": "model-ui.json 仅描述『参数结构 + 上游路径』，不绑定任何协议、不绑定任何供应商。协议由 provider.protocol 单独决定（当前仅实现 openai）。供应商识别靠 baseUrl 解析出的 host 与顶层 key 通配匹配；匹配不到时一律回退 _default（通用兜底模板，非 OpenAI 专属）。",
  "_default": {
    "_comment": "通用兜底模板：任何供应商/协议在下方匹配不到时，前端 UI 与后端构建参数统一使用此处定义。不绑定协议、不绑定供应商。",
    "image": {
      "allowedFields": ["quality", "resolution", "ratio", "n", "refImages"],
      "fields": [
        { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
        { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "ratio", "type": "select",  "order": 3, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "9:16" },
        { "name": "n", "type": "segmented", "order": 4, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
      ],
      "mapping": {
        "refImages": { "field": "image_urls", "kind": "array" }
      }
    },
    "video": {
      "allowedFields": ["ratio", "resolution", "seconds", "generateAudio", "refImages", "refAudios", "refVideos", "refMode"],
      "capabilities": {
        "refMode": { "options": ["text", "image", "first-last", "full"] }
      },
      "fields": [
        { "name": "ratio", "type": "select",  "order": 1, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
        { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
        { "name": "seconds", "type": "slider", "label": "param.duration", "order": 3, "min": 1, "max": 15, "step": 1, "default": 5 },
        { "name": "generateAudio", "type": "switch", "label": "param.audio", "order": 4, "default": true, "trueShort": "param.onShort", "falseShort": "param.offShort" }
      ]
    },
    "llm": {
      "allowedFields": ["messages", "stream"],
      "fields": []
    },
    "audio": {
      "allowedFields": ["mode", "input", "voice", "audio_file", "references"],
      "fields": []
    }
  },

  "*apimart*": {
    "_comment": "供应商 APIMart（OpenAI 协议体系内，已适配）。域名含 apimart 时命中，覆盖 _default 的 endpoints/mapping。",
    "_endpoints": {
      "image.edits": "/images/generations",
      "video.generations": "/videos/generations",
      "image.poll": "/tasks/{task_id}",
      "video.poll": "/tasks/{task_id}"
    },
    "*gpt-image*": {
      "image": {
        "fields": [
          { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
          { "name": "ratio", "type": "select",  "order": 3, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
          { "name": "n", "type": "segmented", "order": 4, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
        ],
        "mapping": {
          "refImages": { "field": "image_urls", "kind": "array" },
          "ratio": { "field": "size", "kind": "single" }
        }
      }
    },
    "*seedance*": {
      "video": {
        "capabilities": {
          "refMode": { "options": ["text", "image", "first-last", "full"] }
        },
        "fields": [
          { "name": "ratio", "type": "select",  "order": 1, "ratio": true, "options": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "adaptive"], "default": "16:9" },
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["480p", "720p", "1080p"], "default": "720p" },
          { "name": "seconds", "type": "slider", "label": "param.duration", "order": 3, "min": 4, "max": 30, "step": 1, "default": 5 },
          { "name": "generateAudio", "type": "switch", "label": "param.audio", "order": 4, "default": false, "trueShort": "param.onShort", "falseShort": "param.offShort" }
        ],
        "mapping": {
          "refImages": { "field": "image_urls", "kind": "array" },
          "ratio": { "field": "size", "kind": "single" },
          "resolution": { "field": "resolution", "kind": "single" },
          "seconds": { "field": "duration", "kind": "single" },
          "generateAudio": { "field": "generate_audio", "kind": "single" },
          "refVideos": { "field": "video_urls", "kind": "array" },
          "refAudios": { "field": "audio_urls", "kind": "array" }
        }
      }
    },
    "MiniMax-H3": {
      "video": {
        "capabilities": {
          "refMode": { "options": ["image", "first-last", "full"] }
        },
        "allowedFields": ["ratio", "resolution", "seconds", "refImages", "refVideos", "refAudios", "refMode"],
        "fields": [
          { "name": "ratio", "type": "select",  "order": 1, "ratio": true, "options": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"], "default": "16:9" },
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["2K", "768P"], "default": "2K" },
          { "name": "seconds", "type": "slider", "label": "param.duration", "order": 3, "min": 4, "max": 15, "step": 1, "default": 5 }
        ],
        "mapping": {
          "ratio": { "field": "aspect_ratio", "kind": "single" },
          "resolution": { "field": "resolution", "kind": "single" },
          "seconds": { "field": "duration", "kind": "single" },
          "refImages": {
            "field": "image_urls",
            "kind": "array",
            "byRefMode": {
              "image": { "field": "first_frame_image", "kind": "slot:first" },
              "first-last": { "field": "image_with_roles", "kind": "role:first-last" },
              "full": { "field": "image_urls", "kind": "array" }
            }
          },
          "refVideos": { "field": "video_urls" },
          "refAudios": { "field": "audio_urls" }
        }
      }
    },
    "*nano-banana-2*": {
      "image": {
        "fields": [
          { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
          { "name": "ratio", "type": "select",  "order": 2, "ratio": true, "options": ["1:1", "2:3", "3:2", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"], "default": "16:9" },
          { "name": "n", "type": "segmented", "order": 3, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
        ]
      }
    },
    "*gemini-3.1*": {
      "image": {
        "fields": [
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 1, "options": ["1K", "2K", "4K"], "default": "1K" },
          { "name": "ratio", "type": "select",  "order": 2, "ratio": true, "options": ["1:1", "2:3", "3:2", "3:4", "4:3", "9:16", "16:9", "21:9"], "default": "16:9" }
        ]
      }
    },
    "*grok-imagine*": {
      "image": {
        "fields": [
          { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
          { "name": "ratio", "type": "select",  "order": 2, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" }
        ],
        "mapping": {
          "ratio": { "field": "size", "kind": "single" }
        }
      }
    },
    "*z-image*": {
      "image": {
        "fields": [
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 1, "options": ["1K", "2K"], "default": "1K" },
          { "name": "ratio", "type": "select",  "order": 2, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" }
        ]
      }
    }
  },

  "*exellome*": {
    "_comment": "供应商 Exellome（OpenAI 协议体系内，已适配）。",
    "_endpoints": {
      "image.edits": "/images/edits"
    },
    "*gpt-image*": {
      "image": {
        "fields": [
          { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
          { "name": "ratio", "type": "select",  "order": 3, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
          { "name": "n", "type": "segmented", "order": 4, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
        ],
        "mapping": {
          "refImages": { "field": "image", "kind": "array" },
          "ratio": { "field": "size", "kind": "single" }
        }
      }
    }
  },

  "*fhl.mom*": {
    "_comment": "供应商 FHL（OpenAI 协议体系内，已适配）。",
    "_endpoints": {
      "image.edits": "/images/edits"
    },
    "*gpt-image*": {
      "image": {
        "fields": [
          { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["1k", "2k", "4k"], "default": "1k" },
          { "name": "ratio", "type": "select",  "order": 3, "ratio": true, "options": ["1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"], "default": "16:9" },
          { "name": "n", "type": "segmented", "order": 4, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
        ],
        "mapping": {
          "refImages": { "field": "images", "kind": "array[].image_url" },
          "ratio": {
            "field": "size",
            "kind": "single",
            "transform": {
              "type": "lookup",
              "composite": ["ratio", "resolution"],
              "table": {
                "1:1|1k": "1024x1024",
