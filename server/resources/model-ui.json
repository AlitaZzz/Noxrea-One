    "*nano-banana2*": {
      "image": {
        "fields": [
          { "name": "quality", "type": "segmented", "order": 1, "options": ["auto", "high", "medium", "low"], "default": "auto" },
          { "name": "ratio", "type": "select",  "order": 2, "ratio": true, "options": ["1:1", "2:3", "3:2", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"], "default": "16:9" },
          { "name": "n", "type": "segmented", "order": 3, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
        ]
      }
    }
  },

  "*agnes*": {
    "_comment": "供应商 Agnes（OpenAI 协议体系内，已适配）。",
    "_endpoints": {
      "image.edits": "/images/generations",
      "video.generations": "/videos",
      "video.poll": "https://api.agnes-ai.cn/agnesapi?video_id={video_id}&model_name={model}"
    },
    "*agnes-image*": {
      "image": {
        "fields": [
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 1, "options": ["1K", "2K", "4K"], "default": "1K" },
          { "name": "ratio", "type": "select",  "order": 2, "ratio": true, "options": ["1:1", "2:3", "3:2", "3:4", "4:3", "9:16", "16:9", "21:9"], "default": "16:9" },
          { "name": "n", "type": "segmented", "order": 3, "options": [1, 2, 4], "default": 1, "unit": "param.unit.n" }
        ],
        "mapping": {
          "refImages": { "field": "extra_body.image", "kind": "array" },
          "resolution": { "field": "size", "kind": "single" },
          "ratio": { "field": "ratio", "kind": "single" }
        }
      }
    },
    "*agnes-video*": {
      "video": {
        "capabilities": {
          "refMode": { "options": ["text","image", "first-last", "full"] }
        },
        "allowedFields": ["ratio", "resolution", "seconds", "refImages", "refVideos", "refAudios", "refMode"],
        "fields": [
          { "name": "ratio", "type": "select",  "order": 1, "ratio": true, "options": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"], "default": "16:9" },
          { "name": "resolution", "type": "select", "label": "param.clarity", "order": 2, "options": ["720P", "960P", "2K"], "default": "720P" },
          { "name": "seconds", "type": "slider", "label": "param.duration", "order": 3, "min": 4, "max": 12, "step": 1, "default": 5 }
        ],
        "derivedFields": {
          "mode": {
            "source": "refMode",
            "table": { "text": "text", "image": "keyframe", "first-last": "keyframe", "full": "reference" },
            "default": "text"
          }
        },
        "mapping": {
          "ratio": { "field": "aspect_ratio", "kind": "single" },
          "resolution": { "field": "size", "kind": "single" },
          "seconds": { "field": "seconds", "kind": "single", "transform": { "type": "stringify" } },
          "refImages": {
            "field": "images",
            "kind": "array",
            "byRefMode": {
              "image": { "field": "first_frame", "kind": "slot:first" },
              "first-last": { "pair": ["first_frame", "last_frame"] },
              "full": { "field": "images", "kind": "array" }
            }
          },
          "refVideos": { "field": "videos", "transform": { "type": "wrap", "key": "url" } },
          "refAudios": { "field": "audios" }
        }
      }
    }
  },

  "_todo_vendors": {
    "_comment": "TODO(vendor)：以下供应商属 OpenAI 协议体系，但需 body 重组 / 响应包装（超出声明式 mapping 能力），本期不实现。待接入时在顶层新增对应 host 通配条目与 _endpoints/mapping。",
    "kie": "需 body 重组（如 normalizeKIEVideoBody），未适配",
    "mimo": "需响应包装（如 copyMiMoTTSResponse），未适配",
    "note": "非 openai 协议（ark/gemini）的 provider 可落库，但发起生成时由 capabilities/*/service.ts 的 getProtocol 守卫抛出『Protocol X does not support Y generation』错误，不静默、不降级。"
  }
}
