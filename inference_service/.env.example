# 推理服务配置 — 复制为 .env 后修改

# API 鉴权 Key（空=开发模式，不鉴权）
API_KEY=change-me-to-a-random-secret

# 模型缓存目录（默认 ./models，可改为绝对路径如 /data/noxrea-models）
# MODEL_CACHE_DIR=./models

# 下载源：modelscope（默认，魔塔→HF镜像→HF官方自动降级）| huggingface
# DOWNLOAD_SOURCE=modelscope

# HuggingFace 访问令牌（briaai/RMBG-2.0 是受限仓库，走魔塔镜像不需要 token）
# HF_TOKEN=hf_xxxx

# 并发处理上限
# INFERENCE_CONCURRENCY=2

# 是否在启动时预加载所有模型（默认 False，懒加载；单模型场景可设为 True）
# MODEL_PRELOAD=False

# 同时驻留显存的模型数量上限（0=不限制，超出按 LRU 自动卸载）
# MAX_LOADED_MODELS=2

# 抠图默认精度：fast(512) | standard(1024) | high(2048)
# BG_REMOVAL_PRECISION=high

# 每次推理后卸载模型释放显存（显存紧张时开启）
# UNLOAD_AFTER_USE=False
