# ============================================================
# Noxrea One 环境变量模板
#
# 使用方式：
#   本地开发（Windows/macOS/Linux）：
#     复制为 .env 即可直接使用（.env 已被 gitignore，不会提交）
#   Docker / NAS 部署：
#     将 .env 放在 docker-compose.nas.yml 同目录，
#     并把下方标注 [Docker] 的三行路径改为容器内路径
#     （或直接删除这三行，容器 entrypoint 会自动使用容器默认值）
#
# 所有变量均有默认值，只有 JWT_SECRET_KEY 必填。
# ============================================================

# ---------- 必填 ----------
# JWT 签名密钥（必填！生成方式：openssl rand -hex 32）
JWT_SECRET_KEY=

# ---------- 数据库 ----------
# SQLite 连接串（本地开发，Windows/macOS/Linux 通用相对路径）
DATABASE_URL=file:./prisma/dev.db
# [Docker] 改为: DATABASE_URL=file:/data/noxrea.db
# 数据库连接超时（秒）
DB_TIMEOUT=30

# ---------- 应用 ----------
APP_NAME=Noxrea One
# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
# 是否开放注册：true / false
ALLOW_REGISTRATION=true

# ---------- HTTP 服务 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# ---------- 前端 ----------
# 后端 API 地址（Next.js 将 /api/* 转发到该地址；单容器部署保持默认）
SERVER_URL=http://localhost:4000
# 注意：浏览器端显示的应用名在镜像构建期固化（Dockerfile ARG APP_NAME），
# 运行期修改 APP_NAME 仅影响后端日志等场景

# ---------- 上传 ----------
# 单文件上传上限（MB）
MAX_UPLOAD_SIZE_MB=30
# 上传文件目录（本地开发，相对项目根）
UPLOAD_DIR=uploads
# [Docker] 改为: UPLOAD_DIR=/data/uploads

# ---------- FFmpeg ----------
# ffmpeg 所在目录（本地开发：项目 bin/ 目录下的 ffmpeg.exe / ffmpeg，
# 代码会根据操作系统自动拼接可执行文件名）
FFMPEG_PATH=bin
# [Docker] 改为: FFMPEG_PATH=/usr/bin

# ---------- 安全 ----------
# 仅本地开发使用：允许占位密钥启动（生产环境切勿开启）
ALLOW_INSECURE_SECRETS=false

# ---------- 可选：JWT ----------
JWT_ALGORITHM=HS256
# 登录态有效期（分钟），默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# ---------- 可选：后台任务 Worker ----------
WORKER_POLL_INTERVAL=1
WORKER_MAX_CONCURRENCY=10
WORKER_API_TIMEOUT=240
WORKER_STUCK_TIMEOUT=5
WORKER_ZOMBIE_INTERVAL=60
WORKER_MAX_RETRIES=2
WORKER_DRAIN_TIMEOUT=15
WORKER_POLL_CHECK_INTERVAL=200
WORKER_ASYNC_POLL_INTERVAL=3.0
WORKER_ASYNC_POLL_MAX_ATTEMPTS=120
WORKER_ASYNC_POLL_INITIAL_DELAY=0.5

# ---------- 可选：HTTP 超时（秒） ----------
HTTP_TIMEOUT_DL=45
HTTP_TIMEOUT_POLL=15
HTTP_TIMEOUT_API=120
HTTP_TIMEOUT_ASYNC=30

# ---------- 可选：SSRF 防护 ----------
# 允许访问的内网主机（逗号分隔），留空表示禁止访问内网
ALLOWED_INTERNAL_HOSTS=

# ---------- 可选：出网代理 ----------
# 访问上游 API 需要走代理时开启
USE_SYSTEM_PROXY=false
PROXY_URL=
