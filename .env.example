# =====================================================
# Noxrea AI Canvas - Environment Variables
# Copy to .env and fill in real values
# =====================================================

# Database
# SQLite (development): file:./prisma/dev.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/noxrea
DATABASE_URL="file:./prisma/dev.db"
DB_TIMEOUT=30

# JWT
JWT_SECRET_KEY="change-me-to-a-random-secret"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Admin account (auto-created on first run via prisma seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD="change-me-to-a-strong-password"

# App
APP_NAME="Noxrea AI Canvas"
LOG_LEVEL=INFO

# Upload
MAX_UPLOAD_SIZE_MB=30

# ── Scene-based HTTP timeouts (seconds) ──
# 1. Download / CDN
HTTP_DL_CONNECT=15
HTTP_DL_READ=30
HTTP_DL_WRITE=10
HTTP_DL_POOL=10

# 2. Async polling (GET /v1/tasks/{id})
HTTP_POLL_CONNECT=10
HTTP_POLL_READ=15
HTTP_POLL_WRITE=10
HTTP_POLL_POOL=5

# 3. Synchronous normal API (/models, /chat/completions)
HTTP_API_CONNECT=10
HTTP_API_READ=120
HTTP_API_WRITE=30
HTTP_API_POOL=10

# 4. Async task creation (POST /v1/images/generations)
HTTP_ASYNC_CONNECT=10
HTTP_ASYNC_READ=30
HTTP_ASYNC_WRITE=30
HTTP_ASYNC_POOL=10

# 5. AI image/video generation (sync) — read timeout
WORKER_API_TIMEOUT=240

# 6. Inference service (bg_removal etc.)
HTTP_TIMEOUT_INFERENCE=300

# Worker
WORKER_POLL_INTERVAL=2
WORKER_MAX_CONCURRENCY=10
WORKER_STUCK_TIMEOUT=20
WORKER_ZOMBIE_INTERVAL=60

# Async polling (used by async providers)
WORKER_ASYNC_POLL_INTERVAL=3.0
WORKER_ASYNC_POLL_MAX_ATTEMPTS=120
WORKER_ASYNC_POLL_INITIAL_DELAY=0.5

# SSRF
ALLOWED_INTERNAL_HOSTS=""

# Mock image generation (dev only)
MOCK_IMAGE_GENERATE=false

# Inference Service (background removal, etc.)
INFERENCE_SERVICE_URL="http://localhost:8100"
INFERENCE_SERVICE_API_KEY=""

# Dev escape hatch: set to true to skip placeholder secret validation
ALLOW_INSECURE_SECRETS=false

# Registration
ALLOW_REGISTRATION=true

# FFmpeg (video frame capture, defaults to bin/ under project root)
# Windows: bin/ffmpeg.exe  Linux/macOS: bin/ffmpeg
FFMPEG_PATH="bin/ffmpeg"

# Proxy (for accessing upstream APIs behind firewall, e.g. http://127.0.0.1:7890)
USE_SYSTEM_PROXY=false
PROXY_URL=""
