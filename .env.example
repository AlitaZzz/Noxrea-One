# =====================================================
# Noxrea AI Canvas - 环境变量配置
# 复制为 .env 并填入实际值
# =====================================================

# 数据库
# SQLite（开发）：file:./prisma/dev.db
# PostgreSQL（生产）：postgresql://user:password@localhost:5432/noxrea
DATABASE_URL="file:./prisma/dev.db"
DB_TIMEOUT=30

# JWT
JWT_SECRET_KEY="change-me-to-a-random-secret"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 应用
APP_NAME="Noxrea AI Canvas"
LOG_LEVEL=INFO

# HTTP 服务器
SERVER_PORT=4000
SERVER_HOST="0.0.0.0"
# 前端 Next 转发目标。同机部署保持默认；分开部署时改为远程 Hono 地址
SERVER_URL="http://localhost:4000"

# 上传
MAX_UPLOAD_SIZE_MB=30
# 上传文件根目录（相对项目根，或绝对路径；由 resolveFromRoot 解析）
# 生产环境可设为绝对路径，如 /var/data/uploads
UPLOAD_DIR="uploads"

# ── HTTP 超时（按场景划分，单位：秒） ──
# 1. 下载 / CDN
HTTP_TIMEOUT_DL=45
# 2. 异步轮询（GET /v1/tasks/{id}）
HTTP_TIMEOUT_POLL=15
# 3. 同步普通接口（/models、/chat/completions）
HTTP_TIMEOUT_API=120
# 4. 异步任务创建（POST /v1/images/generations）
HTTP_TIMEOUT_ASYNC=30

# 5. AI 图片/视频生成（同步）- 读超时
WORKER_API_TIMEOUT=240

# Worker
WORKER_POLL_INTERVAL=2
WORKER_MAX_CONCURRENCY=10
WORKER_STUCK_TIMEOUT=20
WORKER_ZOMBIE_INTERVAL=60

# 异步轮询（异步 provider 使用）
WORKER_ASYNC_POLL_INTERVAL=3.0
WORKER_ASYNC_POLL_MAX_ATTEMPTS=120
WORKER_ASYNC_POLL_INITIAL_DELAY=0.5

# SSRF 防护
ALLOWED_INTERNAL_HOSTS=""

# 开发绕过开关：设为 true 可跳过占位符密钥校验
ALLOW_INSECURE_SECRETS=false

# 注册
ALLOW_REGISTRATION=true

# FFmpeg（存放 ffmpeg 可执行文件的目录，相对项目根或绝对路径；由 resolveFromRoot 解析）
# 代码自动拼接 ffmpeg (Linux/macOS) 或 ffmpeg.exe (Windows)
# 生产环境可设为绝对路径，如 /usr/bin
FFMPEG_PATH="bin"

# 代理（用于穿透防火墙访问上游 API，如 http://127.0.0.1:7890）
USE_SYSTEM_PROXY=false
PROXY_URL=""
