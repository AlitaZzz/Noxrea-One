# ============================================================
# Noxrea One 环境变量模板
#
# 使用方式：
#   本地开发（Windows/macOS/Linux）：
#     复制为 .env 即可直接使用（.env 已被 gitignore，不会提交）
#   Docker / NAS 部署：
#     将 .env 放在 docker-compose.nas.yml 同目录，
#     并把下方标注 [Docker] 的路径改为容器内路径
#     （或直接删除这三行，容器 entrypoint 会自动使用容器默认值）
#
# 必填项：JWT_SECRET_KEY、REDIS_URL、DATABASE_URL；其余变量均有默认值。
#
# 变量按读取方分三区：
#   后端       —— Hono 服务进程读取（server/）
#   前后端共用 —— 前端代理层与后端必须一致的值
#   前端       —— Next 进程读取，统一 WEB_ 前缀（web/）
#
# 这里只放进程引导 / 部署路径 / 密钥类配置。运行期业务参数
# （注册开关、上传限制、Worker、HTTP 超时、出网代理、SSRF 白名单、GC 等）
# 存放在数据库 system_settings 表：首次启动自动以默认值写入，
# 之后以数据库为准，修改后重启生效（键与默认值见 server/core/settings/registry.ts）。
# ============================================================


# ============================================================
# 后端（Hono）
# ============================================================

# ---------- 必填 ----------
# JWT 签名密钥（必填！生成方式：openssl rand -hex 32）
JWT_SECRET_KEY=

# ---------- 数据库（必填，specs/pglite-removal.md） ----------
# 仅支持外置 PostgreSQL：必须以 postgres:// 或 postgresql:// 开头，缺失或非法时启动失败。
# 应用启动不建表也不自动迁移；首次使用先执行 `npm run db:migrate:deploy` 应用 prisma/migrations
# （部署容器由 entrypoint 自动执行；开发机由 `npm run dev` 的 predev 钩子自动执行）。
DATABASE_URL=postgres://noxrea:changeit@localhost:5432/noxrea

# ---------- 测试（仅测试进程读取） ----------
# 真实数据库用例专用库：库名必须包含 test，且不得与 DATABASE_URL 指向同一个库。
# 未设置时本地整体跳过这些用例；CI 环境（CI=true 或 CI=1）未设置则直接失败。
# TEST_DATABASE_URL=postgres://noxrea:changeit@localhost:5432/noxrea_test
# db:migrate:new 必需：只在 shadow 库回放迁移并生成 SQL，不连接 DATABASE_URL；
# shadow 库会被回放/重置，必须可丢弃，且不得与 DATABASE_URL 相同。
# SHADOW_DATABASE_URL=postgres://noxrea:changeit@localhost:5432/noxrea_shadow

# ---------- 任务队列（必填，specs/task-queue-bullmq.md） ----------
# BullMQ 派发用 Redis 连接串（必须有密码，队列实例不与其他服务共享）。
# Redis 不可达时应用启动失败；运行期瞬断由 stalled 重跑与对账清扫自愈。
# REDIS_URL=redis://:changeit@localhost:6379

# ---------- 服务 ----------
# 监听地址与端口。本地开发 / 源码部署时前端代理目标默认随 API_PORT 推导
# （http://localhost:API_PORT）。Docker 镜像内固定为 0.0.0.0:4000，不读取这两项
API_HOST=0.0.0.0
API_PORT=4000
# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ---------- 路径 ----------
# 上传文件目录（本地开发，相对项目根；data/ 已被 gitignore）
UPLOAD_DIR=data/uploads
# [Docker] 改为: UPLOAD_DIR=/data/uploads
# ffmpeg 和 ffprobe 所在目录（本地开发：项目 bin/ 下放置完整发行包的两个可执行文件，
# 代码会根据操作系统自动拼接可执行文件名）
FFMPEG_PATH=bin
# [Docker] 改为: FFMPEG_PATH=/usr/bin
# JSON 配置与技能文件根目录（相对项目根或绝对路径）
# JSON 支持热更新（mtime 缓存，改文件即生效，无需重启）
RESOURCES_DIR=server/resources
# [Docker] 改为: RESOURCES_DIR=/data/resources（首次启动自动播种出厂配置）

# ---------- 安全 ----------
# 仅本地开发使用：允许占位密钥启动（生产环境切勿开启）
ALLOW_INSECURE_SECRETS=false
JWT_ALGORITHM=HS256


# ============================================================
# 前后端共用
# ============================================================

# 单次批量上传总大小上限（MiB；配置键沿用 MB 命名）。
# Next 代理层（proxyClientMaxBodySize）与后端共用此值，故保留在 env
UPLOAD_BATCH_MAX_MB=128


# ============================================================
# 前端（Next，WEB_ 前缀）
# ============================================================

# 路由门（proxy.ts）在后端不可达时的放行策略：
#   fail-open（默认）—— 放行页面（可用性优先，安全由 API 401 拦截器兜底）
#   fail-closed     —— 按未登录处理（安全优先，后端故障期间页面不可用）
WEB_AUTH_GATE_MODE=fail-open

# 浏览器端显示的应用名（构建期固化；Docker 镜像见 Dockerfile ARG WEB_APP_NAME，
# 运行期修改无效）
WEB_APP_NAME=Noxrea One

# 后端 API 源地址：Next 将 /api/* 转发到该地址（在 next build 时固化）。
# 默认 http://localhost:API_PORT，同机部署无需设置；前后端分开部署时取消注释并指向后端：
# WEB_API_ORIGIN=http://backend-host:4000
