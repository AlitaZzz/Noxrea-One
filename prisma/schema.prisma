// ── Noxrea AI Canvas - Prisma Schema ──
// 字段 camelCase + @map("snake_case")，表名 @@map
// JSON 列在 SQLite 下声明为 String(TEXT)，CRUD 层集中序列化

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// 1. User
// ──────────────────────────────────────────
model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique @map("username")
  hashedPassword String   @map("password_hash")
  avatarUrl      String?  @map("avatar")
  role           String   @default("user") @map("role")
  theme          String   @default("dark") @map("theme")
  language       String   @default("zh") @map("lang")
  isActive       Boolean  @default(true) @map("is_active")
  isSuperuser    Boolean  @default(false) @map("is_superuser")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // 关系
  canvasProjects  CanvasProject[]
  generationTasks GenerationTask[]
  modelProviders  ModelProvider[]
  assetFolders    AssetFolder[]
  assetItems      AssetItem[]
  agentSessions   AgentSession[]

  @@map("users")
}

// ──────────────────────────────────────────
// 2. GenerationTask
// ──────────────────────────────────────────
model GenerationTask {
  id             String    @id @map("id") // UUID 字符串主键
  userId         Int       @map("user_id")
  nodeId         String    @map("node_id")

  type           String    @map("type") // 权威模态字段：image | video | llm
  model          String?   @map("model")
  protocol       String?   @map("protocol") // 落库值来自 channel.protocol，仅供记录可读；恢复轮询仍以 task.protocol ?? channel.protocol 链为准
  prompt         String    @default("") @map("prompt")
  config         String    @default("{}") @map("config") // JSON TEXT

  refImages      String?   @map("ref_images") // JSON TEXT：参考图 URL 数组
  refAudios      String?   @map("ref_audios") // JSON TEXT：参考音频 URL 数组
  refVideos      String?   @map("ref_videos") // JSON TEXT：参考视频 URL 数组

  resultUrls     String?   @map("result_urls") // JSON TEXT
  resultText     String?   @map("result_text")

  status         String    @default("pending") @map("status")
  error          String?   @map("error")
  retryCount     Int       @default(0) @map("retry_count")
  upstreamTaskId String?   @map("upstream_task_id")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  // 关系
  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("generation_tasks")
}

// ──────────────────────────────────────────
// 3. CanvasProject
// ──────────────────────────────────────────
model CanvasProject {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  name       String   @default("Untitled") @map("name")
  canvasData String   @default("{}") @map("canvas_data") // JSON TEXT
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("canvas_projects")
}

// ──────────────────────────────────────────
// 4. ModelProvider
// ──────────────────────────────────────────
model ModelProvider {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  name      String    @map("name")
  baseUrl   String    @map("base_url")
  apiKey    String    @default("") @map("api_key")
  protocol  String    @default("openai") @map("protocol")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  // 关系
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  models ModelInfo[]

  @@index([userId])
  @@map("model_providers")
}

// ──────────────────────────────────────────
// 5. ModelInfo
// ──────────────────────────────────────────
model ModelInfo {
  id                   Int         @id @default(autoincrement())
  providerId           Int         @map("provider_id")
  name                 String      @map("name")
  capabilities         String      @default("[]") @map("capabilities") // JSON TEXT
  createdAt            DateTime    @default(now()) @map("created_at")

  // 关系
  provider ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("model_infos")
}

// ──────────────────────────────────────────
// 6. AssetFolder
// ──────────────────────────────────────────
model AssetFolder {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @map("name")
  spaceKey  String   @default("personal") @map("space_key")
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  // 关系
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   AssetFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children AssetFolder[] @relation("FolderHierarchy")
  items    AssetItem[]

  @@index([userId])
  @@index([parentId])
  @@map("asset_folders")
}

// ──────────────────────────────────────────
// 7. AssetItem
// ──────────────────────────────────────────
model AssetItem {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  folderId    Int?     @map("folder_id")
  spaceKey    String   @default("personal") @map("space_key")
  name        String   @default("Untitled") @map("name")
  type        String   @default("other") @map("type")
  mediaType   String   @default("") @map("media_type") // 媒体类型：image/video/audio
  width       Int      @default(0) @map("width")
  height      Int      @default(0) @map("height")
  description String   @default("") @map("description")
  tags        String   @default("[]") @map("tags") // JSON TEXT
  extraData   String   @default("{}") @map("extra_data") // JSON TEXT
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // 关系
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([mediaType])
  @@map("asset_items")
}

// ──────────────────────────────────────────
// 8. FileObject
// ──────────────────────────────────────────
model FileObject {
  userId    Int      @map("user_id")
  hash      String   @map("hash") // SHA256 hex
  size      BigInt   @default(0) @map("size")
  mimeType  String   @default("") @map("mime_type")
  ext       String   @default("") @map("ext")
  source    String   @default("unknown") @map("source")
  refCount  Int      @default(0) @map("ref_count") // 引用计数，归零时可 GC
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userId, hash])
  @@map("file_objects")
}

// ──────────────────────────────────────────
// 9. AgentSession（按画布 project 独立的 Agent 会话）
// ──────────────────────────────────────────
model AgentSession {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  projectId   Int?     @map("project_id")
  title       String   @default("New Chat") @map("title")
  activeSkill String?  @map("active_skill")
  skillStatus String   @default("idle") @map("skill_status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // 关系
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId, projectId])
  @@map("agent_sessions")
}

// ──────────────────────────────────────────
// 11. AgentMessage（会话内的单条消息）
// ──────────────────────────────────────────
model AgentMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  role       String   @map("role") // user | assistant | tool
  content    String   @default("") @map("content")
  toolCallId String?  @map("tool_call_id")
  toolName   String?  @map("tool_name")
  refImages  String?  @map("ref_images") // JSON TEXT：参考图 URL 数组
  createdAt  DateTime @default(now()) @map("created_at")

  // 关系
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("agent_messages")
}
