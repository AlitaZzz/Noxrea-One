# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =====================================================
# Noxrea-AI-Canvas .gitignore
# =====================================================


# =====================================================
# Node.js - Monorepo
# =====================================================

# Dependencies
node_modules/

# Build
dist/

# TypeScript incremental build cache
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local



# =====================================================
# Frontend - Next.js
# =====================================================

# Next.js build
web/.next/
web/out/

# Next.js generated
web/next-env.d.ts



# =====================================================
# Prisma
# =====================================================

prisma/dev.db
prisma/dev.db-shm
prisma/dev.db-wal
prisma/migrations/



# =====================================================
# Backend - Python FastAPI (kept locally as reference, not committed to Git)
# =====================================================

backend/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/



# =====================================================
# Database
# =====================================================

# SQLite (any location)
*.db
*.db-shm
*.db-wal



# =====================================================
# Inference Service
inference_service/__pycache__/
inference_service/.env

# User Generated Files
# =====================================================

# Upload files
uploads/

# Generated assets
storage/
output/
outputs/

# Temporary files
tmp/
temp/



# =====================================================
# Logs
# =====================================================

*.log
logs/
log/



# =====================================================
# AI / Model Files
# =====================================================

# Local models
/models/
inference_service/models/
*.gguf
*.safetensors
*.ckpt
*.pth

# Cache
.cache/
huggingface/
.whisper/



# =====================================================
# Claude Code
# =====================================================

# Local Claude settings
.claude/settings.local.json

# Claude cache
.claude/cache/

# 模型能力推断用的本地参考库（手动刷新，见 backend/scripts/fetch_model_db.py）
backend/app/data/openrouter_models.json



# =====================================================
# IDE
# =====================================================

.vscode/
.idea/
.codebuddy/

# JetBrains
*.iml



# =====================================================
# OS
# =====================================================

.DS_Store
Thumbs.db



# =====================================================
# Runtime
# =====================================================

*.pid
*.lock



# =====================================================
# FFmpeg
# =====================================================

# 项目根目录 bin/，存放 ffmpeg 等平台相关二进制依赖（体积大，不提交到 Git）
bin/
