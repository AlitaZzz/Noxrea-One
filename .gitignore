# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =====================================================
# Noxrea-AI-Canvas .gitignore
# =====================================================


# =====================================================
# Frontend - Next.js
# =====================================================

# Dependencies
frontend/node_modules/

# vitest 从仓库根目录运行时产生的缓存（node_modules/.vite）
node_modules/

# Next.js build
frontend/.next/
frontend/out/

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Next.js generated
frontend/next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo



# =====================================================
# Backend - Python FastAPI
# =====================================================

# Environment variables
.env
backend/.env

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
# 后端测试运行时产生的临时上传目录（conftest.TEST_UPLOAD_DIR）
backend/tests/fixtures/.test_uploads/



# =====================================================
# Database
# =====================================================

# SQLite
*.db
*.db-shm
*.db-wal

backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal



# =====================================================
# Inference Service
inference_service/__pycache__/
inference_service/.env

# User Generated Files
# =====================================================

# Upload files
backend/uploads/

# Generated assets
backend/storage/
backend/output/
backend/outputs/

# Temporary files
tmp/
temp/



# =====================================================
# Logs
# =====================================================

*.log
logs/
log/



# =====================================================
# AI / Model Files
# =====================================================

# Local models
/models/
inference_service/models/
*.gguf
*.safetensors
*.ckpt
*.pth

# Cache
.cache/
huggingface/
.whisper/



# =====================================================
# Claude Code
# =====================================================

# Local Claude settings
.claude/settings.local.json

# Claude cache
.claude/cache/

# 模型能力推断用的本地参考库（手动刷新，见 backend/scripts/fetch_model_db.py）
backend/app/data/openrouter_models.json



# =====================================================
# IDE
# =====================================================

.vscode/
.idea/
.codebuddy/

# JetBrains
*.iml



# =====================================================
# OS
# =====================================================

.DS_Store
Thumbs.db



# =====================================================
# Runtime
# =====================================================

*.pid
*.lock



# =====================================================
# FFmpeg
# =====================================================

# 如果 ffmpeg.exe 是项目运行依赖，不要取消下面注释，ffmpeg 体积过大 (>100MB)，不提交到 Git
backend/bin/
