# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =====================================================
# Noxrea-AI-Canvas .gitignore
# =====================================================


# =====================================================
# Node.js - Monorepo
# =====================================================

# Dependencies
node_modules/

# Build
dist/

# TypeScript incremental build cache
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local



# =====================================================
# Frontend - Next.js
# =====================================================

# Next.js build
web/.next/
web/out/

# Next.js generated
web/next-env.d.ts



# =====================================================
# Prisma
# =====================================================

prisma/dev.db
prisma/dev.db-shm
prisma/dev.db-wal
# prisma/migrations/ 已纳入版本控制（共享迁移历史，不在此忽略）



# =====================================================
# Python (inference_service 等)
# =====================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/



# =====================================================
# Database
# =====================================================

# SQLite (any location)
*.db
*.db-shm
*.db-wal



# =====================================================
# Inference Service
inference_service/__pycache__/
inference_service/.env

# User Generated Files
# =====================================================

# Upload files（本地文件存储）
/uploads/

# Generated assets（锚定根目录，避免误伤 server/services/storage 等同名源码目录）
/storage/
/output/
/outputs/

# Temporary files
/tmp/
/temp/



# =====================================================
# Logs
# =====================================================

*.log
/logs/
/log/



# =====================================================
# AI / Model Files
# =====================================================

# Local models
/models/
inference_service/models/
*.gguf
*.safetensors
*.ckpt
*.pth

# Cache
.cache/
huggingface/
.whisper/



# =====================================================
# Claude Code
# =====================================================

# Local Claude settings
.claude/settings.local.json

# Claude cache
.claude/cache/



# =====================================================
# IDE
# =====================================================

.vscode/
.idea/
.codebuddy/

# JetBrains
*.iml



# =====================================================
# OS
# =====================================================

.DS_Store
Thumbs.db



# =====================================================
# Runtime
# =====================================================

*.pid
*.lock



# =====================================================
# FFmpeg
# =====================================================

# bin/，存放 ffmpeg 等平台相关二进制依赖（体积大，不提交到 Git）
/bin/
