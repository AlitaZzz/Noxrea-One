# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =====================================================
# Noxrea One .gitignore
# =====================================================


# =====================================================
# Node.js - Monorepo
# =====================================================

# Dependencies
node_modules/

# Build
dist/

# TypeScript incremental build cache
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local



# =====================================================
# Frontend - Next.js
# =====================================================

# Next.js build
web/.next/
web/out/

# Next.js generated
web/next-env.d.ts



# =====================================================
# Prisma
# =====================================================

# 本地模式数据目录（PGlite，specs/postgres-dialect-unification.md；默认 data/pglite，含测试临时实例）
data/

# Prisma Client 生成物（postinstall 的 prisma generate 自动生成，不入库）
server/core/database/generated/

# 迁移整理时的本地备份目录（不纳入版本控制）
prisma/backups/



# =====================================================
# Python (inference_service 等)
# =====================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/



# =====================================================
# Database
# =====================================================

# SQLite (any location)
*.db
*.db-shm
*.db-wal



# =====================================================
# Inference Service
inference_service/__pycache__/
inference_service/.env

# User Generated Files
# =====================================================

# Upload files（本地文件存储）
/uploads/

# Generated assets（锚定根目录，避免误伤 server/services/storage 等同名源码目录）
/storage/

# 存储迁移脚本的续跑日志与报告（specs/storage-s3-backend.md 规则 11；不锚定根，
# 覆盖 UPLOAD_DIR 配置为仓库内非默认布局时产物落在存储根旁的场景）
storage-migration/
/output/
/outputs/

# Temporary files
/tmp/
/temp/



# =====================================================
# Logs
# =====================================================

*.log
/logs/
/log/



# =====================================================
# AI / Model Files
# =====================================================

# Local models
/models/
inference_service/models/
*.gguf
*.safetensors
*.ckpt
*.pth

# Cache
.cache/
huggingface/
.whisper/



# =====================================================
# Claude Code
# =====================================================

# Local Claude settings
.claude/settings.local.json

# Claude cache
.claude/cache/
.claude/

# Skills CLI（个人技能，不随仓库共享）
.agents/
skills-lock.json


# =====================================================
# IDE
# =====================================================

.vscode/
.idea/
.codebuddy/

# JetBrains
*.iml



# =====================================================
# OS
# =====================================================

.DS_Store
Thumbs.db



# =====================================================
# Runtime
# =====================================================

*.pid
*.lock



# =====================================================
# FFmpeg
# =====================================================

# bin/，存放 ffmpeg 等平台相关二进制依赖（体积大，不提交到 Git）
/bin/
