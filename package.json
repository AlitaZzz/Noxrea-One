{
  "name": "noxrea-one",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm -w web run dev\" \"tsx watch --env-file=.env server/index.ts\"",
    "dev:web": "npm -w web run dev",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "server": "tsx --env-file=.env server/index.ts",
    "build": "npm -w web run build",
    "start": "concurrently -n web,server -c cyan,magenta \"npm -w web run start\" \"npm run server\"",
    "lint": "npm run lint:web && npm run lint:server",
    "lint:web": "npm -w web run lint",
    "lint:server": "eslint server shared scripts",
    "typecheck": "tsc --noEmit && npx tsc --noEmit -p web/tsconfig.json",
    "test": "npm run test:server && npm -w web run test",
    "test:server": "vitest run --config vitest.config.ts",
    "test:watch": "npm -w web run test:watch",
    "prisma:generate": "prisma generate",
    "db:migrate:new": "tsx scripts/db/author-migration.mts",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "zustand": "^5.0.14",
    "three": "^0.186.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.0.12",
    "@noxrea/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@streamparser/json": "^0.0.26",
    "bcryptjs": "^2.4.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.33",
    "ipaddr.js": "^2.5.0",
    "jose": "^5.9.0",
    "p-limit": "^6.1.0",
    "pglite-prisma-adapter": "^0.7.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sharp": "^0.33.0",
    "undici": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "prisma": "^7.10.0",
    "prisma-pglite": "^3.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0"
  }
}
