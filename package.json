{
  "name": "noxrea-one",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "web",
    "shared"
  ],
  "scripts": {
    "predev": "npm run db:migrate:deploy",
    "dev": "concurrently -n web,server -c cyan,magenta \"npm -w web run dev\" \"tsx watch --env-file=.env server/index.ts\"",
    "dev:web": "npm -w web run dev",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "server": "tsx --env-file=.env server/index.ts",
    "build": "npm -w web run build",
    "start": "concurrently -n web,server -c cyan,magenta \"npm -w web run start\" \"npm run server\"",
    "lint": "npm run lint:web && npm run lint:server",
    "lint:web": "npm -w web run lint",
    "lint:server": "eslint server shared scripts",
    "typecheck": "tsc --noEmit && npx tsc --noEmit -p web/tsconfig.json",
    "test": "npm run test:server && npm -w web run test",
    "test:server": "vitest run --config vitest.config.ts",
    "test:storage:minio": "vitest run --config vitest.minio.config.ts",
    "test:watch": "npm -w web run test:watch",
    "prisma:generate": "prisma generate",
    "db:migrate:new": "tsx --env-file=.env scripts/db/author-migration.mts",
    "db:migrate:deploy": "tsx --env-file=.env scripts/db/migrate-deploy.mts",
    "storage:audit": "tsx --env-file=.env scripts/storage/audit.mts",
    "storage:gc": "tsx --env-file=.env scripts/storage/gc.mts",
    "storage:migrate": "tsx --env-file=.env scripts/storage/migrate.mts",
    "storage:purge-legacy-cache": "tsx --env-file=.env scripts/storage/purge-legacy-cache.mts",
    "storage:provider-check": "tsx --env-file=.env scripts/storage/provider-check.mts",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "zustand": "^5.0.14",
    "three": "^0.186.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hono/node-server": "^2.0.12",
    "@noxrea/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "@streamparser/json": "^0.0.26",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.17",
    "hono": "^4.12.33",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sharp": "^0.35.5",
    "undici": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0"
  }
}
